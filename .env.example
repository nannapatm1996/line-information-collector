LINE_CHANNEL_SECRET=your_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_long_lived_channel_access_token
ANTHROPIC_API_KEY=your_llm_api_key
# SQL Server (same Windows server):
DATABASE_URL=mssql+pyodbc://line_app:password@localhost/factory?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# PostgreSQL alternative:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/factory
LLM_MODEL=claude-haiku-5-5

# ---- End-of-day report (daily_report.py) ----
REPORT_TZ=Asia/Bangkok

# Email (leave SMTP_HOST empty to skip email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=reports@yourcompany.com
SMTP_PASSWORD=app_password_here
SMTP_FROM=reports@yourcompany.com
REPORT_EMAIL_TO=manager@yourcompany.com,owner@yourcompany.com

# LINE push to one account (leave empty to skip). userId starts with U, groupId with C.
REPORT_LINE_TO=
